{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "unicali.app"
        }
      ],
      "destination": "https://www.unicali.app/$1",
      "permanent": true
    },
    {
      "source": "/resenas",
      "destination": "/reseñas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/biblioteca",
      "destination": "/api/library"
    },
    {
      "source": "/biblioteca/:uni",
      "destination": "/api/library"
    },
    {
      "source": "/biblioteca/:uni/:program",
      "destination": "/api/library"
    },
    {
      "source": "/biblioteca/:uni/:program/:course",
      "destination": "/api/library"
    },
    {
      "source": "/sitemap-:chunk.xml",
      "destination": "/api/sitemap?chunk=:chunk"
    },
    {
      "source": "/d/:pid",
      "destination": "/api/material"
    },
    {
      "source": "/d/:pid/:slug",
      "destination": "/api/material"
    },
    {
      "source": "/calculadora/:escuela",
      "destination": "/api/seo"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/dev",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
